# 复制成 .env 后按自己的环境改，改完 docker compose up -d

# ── 镜像地址（用作者打包好的，或你自己的账号）──
IMGPROXY_IMAGE=ghcr.io/xiaotian89/immortal-addons-imgproxy:5.5
HARVESTER_IMAGE=ghcr.io/xiaotian89/immortal-addons-harvester:1.0

# ── 数据库（原版 immortal 的 PG）──
# 跟原版跑在同一个 compose 里就保持 postgres；分开部署就填真实地址
DB_HOST=postgres
DB_PORT=5432
DB_USER=immortal
DB_PASSWORD=改成你的数据库密码
DB_NAME=immortal_db

# ── 图片代理 ──
# 浏览器访问用的地址：必须是你 NAS/服务器的局域网或公网 IP，不能写 127.0.0.1
IMG_PROXY_BASE=http://192.168.1.10:8002
IMGPROXY_PORT=8002
CACHE_DIR=./imgcache
MAX_CACHE_MB=2048

# ── 上游代理（可选）──
# 部分图床国内直连被 RST，填 HTTP 代理地址；全部能直连就留空
UPSTREAM_PROXY=

# ── 采集器 ──
HARVESTER_INTERVAL=1800
HARVESTER_LOG_DIR=./logs
SITE_BASE=https://169bt.com
PAGES=1
MAX_POSTS=24
DELAY=0.6
DRY_RUN=0

# ── 改写频率（秒）──
REWRITE_INTERVAL=300

# ── 容器名（机器上已有同名容器时改这里）──
IMGPROXY_NAME=immortal-imgproxy
HARVESTER_NAME=immortal-harvester
IMGREWRITE_NAME=immortal-imgrewrite
